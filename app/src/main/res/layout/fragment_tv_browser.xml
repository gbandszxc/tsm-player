<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_tv_blue">

    <!-- 液态玻璃氛围底：模糊封面铺满 + 暗化遮罩，内容层位于其上 -->
    <ImageView
        android:id="@+id/iv_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/view_ambient_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_ambient_scrim" />

    <ScrollView
        android:id="@+id/root_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/ui_nav_rail_content_start_margin"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingTop="@dimen/ui_space_4xl"
            android:paddingEnd="@dimen/ui_space_4xl"
            android:paddingBottom="@dimen/ui_space_4xl">

            <LinearLayout
                android:id="@+id/panel_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:padding="@dimen/ui_space_3xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_connection_section"
                    android:textColor="@color/ui_accent_blue_text"
                    android:textSize="@dimen/ui_text_section_title"
                    android:fontFamily="@font/misans_bold" />

                <TextView
                    android:id="@+id/tv_connection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_md"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_title"
                    android:fontFamily="@font/misans_medium" />

                <TextView
                    android:id="@+id/tv_saved_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_xs"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="@dimen/ui_text_body_large"
                    android:fontFamily="@font/misans_regular" />

                <Button
                    android:id="@+id/btn_manage"
                    style="@style/TsmButtonPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_xl"
                    android:minWidth="180dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/browser_manage_connection"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_playback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_space_3xl"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:padding="@dimen/ui_space_3xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_playback_controls"
                    android:textColor="@color/ui_accent_blue_text"
                    android:textSize="@dimen/ui_text_section_title"
                    android:fontFamily="@font/misans_bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_lg"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_play_all"
                        style="@style/TsmButtonSuccess"
                        android:layout_width="@dimen/ui_playback_mode_button_collapsed_width"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/ui_space_sm"
                        android:gravity="center"
                        android:minWidth="@dimen/ui_playback_mode_button_collapsed_width"
                        android:text=""
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_play_shuffle"
                        style="@style/TsmButtonSuccess"
                        android:layout_width="@dimen/ui_playback_mode_button_collapsed_width"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_space_lg"
                        android:drawablePadding="@dimen/ui_space_sm"
                        android:gravity="center"
                        android:minWidth="@dimen/ui_playback_mode_button_collapsed_width"
                        android:text=""
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_now_playing"
                        style="@style/TsmButtonWarning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ui_space_lg"
                        android:paddingStart="@dimen/ui_space_2xl"
                        android:paddingEnd="@dimen/ui_space_2xl"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:text="@string/browser_now_playing"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_space_3xl"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:padding="@dimen/ui_space_3xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_file_browser"
                    android:textColor="@color/ui_accent_blue_text"
                    android:textSize="@dimen/ui_text_section_title"
                    android:fontFamily="@font/misans_bold" />

                <TextView
                    android:id="@+id/tv_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_md"
                    android:background="@drawable/bg_path_bar"
                    android:padding="@dimen/ui_space_lg"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_title"
                    android:fontFamily="@font/misans_medium" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_xl"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:fillViewport="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_refresh"
                            style="@style/TsmButtonDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="130dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/browser_refresh_current_dir"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/btn_sort"
                            style="@style/TsmButtonDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="130dp"
                            android:layout_marginStart="@dimen/ui_space_lg"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/browser_sort_name_asc"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/btn_view_mode"
                            style="@style/TsmButtonDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ui_space_lg"
                            android:gravity="center"
                            android:maxLines="1"
                            android:minWidth="@dimen/ui_playback_mode_button_collapsed_width"
                            android:text=""
                            android:textAllCaps="false" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_lg"
                    android:textColor="@color/ui_text_error"
                    android:textSize="@dimen/ui_text_body_medium"
                    android:fontFamily="@font/misans_regular"
                    android:visibility="gone" />

                <GridLayout
                    android:id="@+id/container_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_lg"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:columnCount="1"
                    android:orientation="horizontal" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 左侧导轨展开时的右半区轻遮罩：点击可收起导轨 -->
    <View
        android:id="@+id/view_nav_rail_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/ui_bg_overlay"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <!-- 左侧可折叠液态玻璃导轨：静置 64dp 胶囊图标栏，按 ← 平滑展开至 212dp -->
    <FrameLayout
        android:id="@+id/panel_nav_rail"
        android:layout_width="@dimen/ui_nav_rail_collapsed_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/ui_space_4xl"
        android:layout_marginTop="@dimen/ui_space_4xl"
        android:layout_marginBottom="@dimen/ui_space_4xl"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/ui_space_md">

        <LinearLayout
            android:id="@+id/container_nav_rail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_back_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_space_xs"
                android:background="@drawable/bg_nav_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_space_xl"
                android:paddingEnd="@dimen/ui_space_xl">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_back"
                    android:tint="@color/ui_text_primary" />

                <TextView
                    android:id="@+id/tv_nav_back_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_space_2xl"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans_medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/browser_nav_back"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_body_large" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_browse_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_space_xs"
                android:background="@drawable/bg_nav_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_space_xl"
                android:paddingEnd="@dimen/ui_space_xl">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_switch_source"
                    android:tint="@color/ui_accent_blue_text" />

                <TextView
                    android:id="@+id/tv_nav_mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_space_2xl"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans_medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/browser_mode_local"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_body_large" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_space_xs"
                android:background="@drawable/bg_nav_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_space_xl"
                android:paddingEnd="@dimen/ui_space_xl">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_favorite_filled"
                    android:tint="@color/ui_accent_red_text" />

                <TextView
                    android:id="@+id/tv_nav_favorites_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_space_2xl"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans_medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/favorites_title"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_body_large" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_space_xs"
                android:background="@drawable/bg_nav_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_space_xl"
                android:paddingEnd="@dimen/ui_space_xl">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_history"
                    android:tint="@color/ui_text_warning_glass" />

                <TextView
                    android:id="@+id/tv_nav_history_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_space_2xl"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans_medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/history_title"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_body_large" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_nav_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_space_xs"
                android:background="@drawable/bg_nav_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_space_xl"
                android:paddingEnd="@dimen/ui_space_xl">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_connection"
                    android:tint="@color/ui_accent_cyan" />

                <TextView
                    android:id="@+id/tv_nav_connection_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_space_2xl"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans_medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/browser_connection_section"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_body_large" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_space_xl"
                android:paddingEnd="@dimen/ui_space_xl">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/ui_text_primary" />

                <TextView
                    android:id="@+id/tv_nav_settings_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_space_2xl"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans_medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/browser_settings"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/ui_text_body_large" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel_fast_locate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/ui_space_4xl"
        android:layout_marginBottom="@dimen/ui_space_4xl"
        android:background="@drawable/bg_modal_panel"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_space_2xl"
        android:paddingTop="@dimen/ui_space_xl"
        android:paddingEnd="@dimen/ui_space_xl"
        android:paddingBottom="@dimen/ui_space_xl"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fast_locate_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/browser_fast_locate_hint"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/ui_text_body_large"
                android:fontFamily="@font/misans_bold" />

            <TextView
                android:id="@+id/tv_fast_locate_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_space_md"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ui_accent_blue_stroke_soft"
                android:textSize="@dimen/ui_text_body"
                android:fontFamily="@font/misans_medium" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/view_fast_locate_track"
            android:layout_width="14dp"
            android:layout_height="136dp"
            android:layout_marginStart="@dimen/ui_space_2xl"
            android:padding="2dp"
            android:background="@drawable/bg_fast_locate_track">

            <View
                android:id="@+id/view_fast_locate_indicator"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_fast_locate_indicator" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
