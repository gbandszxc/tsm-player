<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页主布局：液态玻璃氛围底 + 左侧分类面板 + 右侧详情面板 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 液态玻璃氛围底：模糊封面铺满 + 暗化遮罩，内容层位于其上 -->
    <ImageView
        android:id="@+id/iv_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/view_ambient_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_ambient_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/ui_space_4xl">

        <!-- 左侧：悬浮分类玻璃面板 -->
        <LinearLayout
            android:id="@+id/panel_settings_sidebar"
            android:layout_width="196dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="@dimen/ui_space_lg">

            <TextView
                style="@style/TsmTextPageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ui_space_md"
                android:paddingTop="@dimen/ui_space_xs"
                android:paddingEnd="@dimen/ui_space_md"
                android:paddingBottom="@dimen/ui_space_lg"
                android:text="@string/settings_title" />

            <!-- 分类列表（动态填充）：小屏触摸设备可纵向滑动 -->
            <com.github.gbandszxc.tvmediaplayer.ui.NonFocusableScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:fillViewport="false"
                android:padding="@dimen/ui_space_xs"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

            </com.github.gbandszxc.tvmediaplayer.ui.NonFocusableScrollView>

        </LinearLayout>

        <!-- 右侧：悬浮详情玻璃面板（自适应剩余宽度） -->
        <LinearLayout
            android:id="@+id/panel_settings_detail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ui_space_3xl"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="@dimen/ui_space_2xl">

            <TextView
                android:id="@+id/tv_settings_detail_title"
                style="@style/TsmTextSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ui_space_xs"
                android:paddingEnd="@dimen/ui_space_xs"
                android:paddingBottom="@dimen/ui_space_lg" />

            <com.github.gbandszxc.tvmediaplayer.ui.NonFocusableScrollView
                android:id="@+id/scroll_settings_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:fillViewport="false"
                android:padding="@dimen/ui_space_xs"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

            </com.github.gbandszxc.tvmediaplayer.ui.NonFocusableScrollView>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
