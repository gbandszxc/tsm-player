<?xml version="1.0" encoding="utf-8"?>
<!-- 暗色按钮：半透明玻璃平铺，聚焦白色完整描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/ui_radius_button" />
            <solid android:color="@color/ui_glass_item_focus" />
            <stroke
                android:width="@dimen/ui_stroke_focus"
                android:color="@color/ui_text_primary" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ui_radius_button" />
            <solid android:color="@color/ui_glass_item" />
        </shape>
    </item>
</selector>
