<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 当前分类同时获得遥控器焦点：焦点框优先，左侧指示条由子 View 保留 -->
    <item android:state_focused="true" android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_panel" />
                    <solid android:color="@color/ui_accent_blue_focus" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/ui_stroke_focus"
                android:left="@dimen/ui_stroke_focus"
                android:right="@dimen/ui_stroke_focus"
                android:top="@dimen/ui_stroke_focus">
                <shape>
                    <corners android:radius="@dimen/ui_radius_button" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/ui_glass_gloss_top"
                        android:endColor="@color/ui_glass_gloss_bottom" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_panel" />
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/ui_stroke_focus"
                        android:color="@color/ui_accent_blue_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 遥控器焦点在此项 -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_panel" />
                    <solid android:color="@color/ui_accent_blue_focus" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/ui_stroke_focus"
                android:left="@dimen/ui_stroke_focus"
                android:right="@dimen/ui_stroke_focus"
                android:top="@dimen/ui_stroke_focus">
                <shape>
                    <corners android:radius="@dimen/ui_radius_button" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/ui_glass_gloss_top"
                        android:endColor="@color/ui_glass_gloss_bottom" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_panel" />
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/ui_stroke_focus"
                        android:color="@color/ui_accent_blue_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 当前选中分类：半透明玻璃低亮底 -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_panel" />
                    <solid android:color="@color/ui_glass_panel_muted" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_panel" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/ui_glass_gloss_top"
                        android:endColor="@color/ui_glass_gloss_bottom" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 默认 -->
    <item>
        <shape>
            <corners android:radius="@dimen/ui_radius_panel" />
            <solid android:color="@color/ui_transparent" />
        </shape>
    </item>
</selector>
