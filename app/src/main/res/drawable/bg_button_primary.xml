<?xml version="1.0" encoding="utf-8"?>
<!-- 主操作按钮（1B 染色玻璃 + 2A 胶囊）：静置低饱和烟熏蓝玻璃 + 同色折射边，聚焦充能高亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="100">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_button" />
                    <solid android:color="@color/ui_glass_blue_focus" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/ui_stroke_focus"
                android:left="@dimen/ui_stroke_focus"
                android:right="@dimen/ui_stroke_focus"
                android:top="@dimen/ui_stroke_focus">
                <shape>
                    <corners android:radius="@dimen/ui_radius_button" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/ui_glass_gloss_top"
                        android:endColor="@color/ui_glass_gloss_bottom" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_button" />
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/ui_stroke_focus"
                        android:color="@color/ui_accent_blue_stroke_soft" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_button" />
                    <solid android:color="@color/ui_glass_blue" />
                    <stroke
                        android:width="@dimen/ui_stroke_glass_rim"
                        android:color="@color/ui_glass_blue_rim" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_button" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/ui_glass_gloss_top"
                        android:endColor="@color/ui_glass_gloss_bottom" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
