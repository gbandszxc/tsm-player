<?xml version="1.0" encoding="utf-8"?>
<!-- 排序下拉浮层：修复 solid+gradient 互相覆盖问题，使用独立填充层 + 顶部光泽 + 蓝色折射边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ui_radius_card" />
            <solid android:color="@color/ui_glass_panel_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ui_radius_card" />
            <gradient
                android:angle="270"
                android:startColor="@color/ui_glass_gloss_top"
                android:endColor="@color/ui_glass_gloss_bottom" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ui_radius_card" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/ui_stroke_glass_rim"
                android:color="@color/ui_accent_blue_stroke" />
        </shape>
    </item>
</layer-list>
