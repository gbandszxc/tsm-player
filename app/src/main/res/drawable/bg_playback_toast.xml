<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页轻提示：胶囊液态玻璃浮层 + 独立底色填充 + 亮蓝折射边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/ui_radius_button" />
            <solid android:color="@color/ui_glass_panel_strong" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ui_radius_button" />
            <gradient
                android:angle="270"
                android:startColor="@color/ui_glass_gloss_top"
                android:endColor="@color/ui_glass_gloss_bottom" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ui_radius_button" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/ui_stroke_glass_rim"
                android:color="@color/ui_accent_blue_stroke" />
        </shape>
    </item>
</layer-list>
