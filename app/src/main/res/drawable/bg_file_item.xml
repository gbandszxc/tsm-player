<?xml version="1.0" encoding="utf-8"?>
<!-- 文件行/宫格卡选择器：静置纯半透明平铺（密集列表不做 rim/gloss 装饰），聚焦完整语义环 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/ui_radius_item" />
            <solid android:color="@color/ui_glass_item_focus" />
            <stroke
                android:width="@dimen/ui_stroke_focus"
                android:color="@color/ui_accent_green_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ui_radius_item" />
            <solid android:color="@color/ui_glass_item" />
        </shape>
    </item>
</selector>
