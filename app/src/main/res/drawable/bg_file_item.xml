<?xml version="1.0" encoding="utf-8"?>
<!-- 文件行/宫格卡选择器：静置轻透烟熏玻璃，聚焦亮玻璃 + 绿色语义描边（配合滑动液态焦点框） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="100"
    android:exitFadeDuration="80">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/ui_radius_item" />
            <solid android:color="@color/ui_glass_item_focus" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/ui_radius_item" />
            <solid android:color="@color/ui_glass_item" />
        </shape>
    </item>
</selector>
