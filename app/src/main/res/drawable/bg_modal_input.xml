<?xml version="1.0" encoding="utf-8"?>
<!-- Modal 表单输入框背景：玻璃底，聚焦态蓝色描边，默认态发丝线描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_item" />
                    <solid android:color="@color/ui_glass_panel_deep" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/ui_stroke_focus"
                android:left="@dimen/ui_stroke_focus"
                android:right="@dimen/ui_stroke_focus"
                android:top="@dimen/ui_stroke_focus">
                <shape>
                    <corners android:radius="@dimen/ui_radius_indicator" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/ui_glass_gloss_top"
                        android:endColor="@color/ui_glass_gloss_bottom" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_item" />
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/ui_stroke_focus"
                        android:color="@color/ui_accent_blue_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_item" />
                    <solid android:color="@color/ui_glass_panel_deep" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_item" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/ui_glass_gloss_top"
                        android:endColor="@color/ui_glass_gloss_bottom" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/ui_radius_item" />
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/ui_stroke_hairline"
                        android:color="@color/ui_divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
